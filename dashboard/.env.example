# Required — the GitHub repo the dashboard reads dashboard_data/*.json and
# config.json from, at runtime (not bundled at build time).
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name
GITHUB_BRANCH=main

# Optional — only needed if the repository above is private. Never prefix
# this with NEXT_PUBLIC_; it is read server-side only and never sent to
# the browser.
GITHUB_TOKEN=
